# VoiceSarathi Environment Variables
# DO NOT commit this file to version control

# 1. Google Maps JavaScript API key
# Get yours at: https://console.cloud.google.com/google/maps-apis/
# Required APIs to enable: "Maps JavaScript API"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# 2. ISRO Bhuvan API Token / Key (Optional)
# Public Bhuvan thematic WMS tiles (https://bhuvan-vec1.nrsc.gov.in) work without a key by default.
# If you have a registered NRSC/ISRO Bhuvan developer token, paste it here:
NEXT_PUBLIC_BHUVAN_API_KEY=YOUR_BHUVAN_API_KEY_HERE

# 3. NextAuth / Auth.js Configuration
NEXTAUTH_SECRET=voicesarathi-ultra-secure-development-secret-key-32chars
NEXTAUTH_URL=http://localhost:3000

# 4. Neon Postgres Database URL (Backend integration)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/voicesarathi?sslmode=require
