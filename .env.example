# VoiceSarathi Environment Variables
# Copy this file to .env.local and replace with your actual keys

# Browser-only Google Maps JavaScript API key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Server-side integrations (never add NEXT_PUBLIC_ to these secrets)
GOOGLE_MAPS_API_KEY=YOUR_SERVER_SIDE_GOOGLE_MAPS_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# 2. ISRO Bhuvan API Token / Key (Optional)
NEXT_PUBLIC_BHUVAN_API_KEY=YOUR_BHUVAN_API_KEY_HERE

# NextAuth configuration (generate a unique random secret)
NEXTAUTH_SECRET=GENERATE_A_RANDOM_SECRET_HERE
NEXTAUTH_URL=http://localhost:3000

# Neon Postgres pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
